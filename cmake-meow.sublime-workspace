{
  "folders":
  [
    {
      "path": "."
    }
  ],
  "settings":
  {
    "tab_size": 2,
    "LSP":
    {
        "clangd":
        {
          "initializationOptions":
          {
            "clangd.compile-commands-dir": "./cmake-build-debug"
          }
        }
      }
  },
  "build_systems":
  [
    {
      "name": "compile-run",
      "shell_cmd":
        "cd $folder && cmake -S . -B ./cmake-build -G Ninja -DCMAKE_EXPORT_COMPILE_COMMANDS=1 && cmake --build ./cmake-build && ./bin/meowgame"
    },
  ]
}
